# Copy to /mnt/REPLACE_APPS_POOL/appconfig/trusten.env on the TrueNAS host.
# Replace only the provider credentials you want to use. Trusten also works
# without an LLM key by using deterministic detection and fixed workflows.
TZ=America/Los_Angeles
LOG_LEVEL=info

# PostgreSQL is the production system of record. Keep this password only in
# the private deployment configuration.
DATABASE_URL=postgresql://trusten:REPLACE_POSTGRES_PASSWORD@postgres:5432/trusten

# Public demo bot protection. The site key belongs in the web deployment; only
# the private secret is configured on this API container.
TRUSTEN_TURNSTILE_MODE=enforce
TRUSTEN_TURNSTILE_SECRET_KEY=REPLACE_WITH_PRIVATE_SECRET
TRUSTEN_TURNSTILE_EXPECTED_HOSTNAME=REPLACE_TRUSTEN_HOSTNAME
TRUSTEN_TURNSTILE_EXPECTED_ACTION=scan-submit
TRUSTEN_CAPABILITY_HASH_KEY=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
# Emergency only; leave disabled for the public deployment.
TRUSTEN_ALLOW_INSECURE_BOT_BYPASS=0
# TRUSTEN_TURNSTILE_TIMEOUT_MS=5000
# TRUSTEN_DEMO_SESSION_LIMIT=3
# TRUSTEN_DEMO_SESSION_WINDOW_MS=3600000
# TRUSTEN_DEMO_IP_LIMIT=10
# TRUSTEN_DEMO_IP_WINDOW_MS=3600000
# TRUSTEN_DEMO_DOMAIN_LIMIT=1
# TRUSTEN_DEMO_DOMAIN_WINDOW_MS=600000
# TRUSTEN_DEMO_MAX_OUTSTANDING=2

# Optional scanning controls
# TRUSTEN_IGNORE_ROBOTS=0
# TRUSTEN_RATE_WINDOW_MS=60000
# TRUSTEN_LLM_TIMEOUT_MS=8000

# Optional LLM provider: nvidia-nim | gemini | deepseek | openrouter | ollama
# TRUSTEN_LLM_PROVIDER=nvidia-nim
# NVIDIA_NIM_API_KEY=REPLACE_ME
# NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
# NVIDIA_NIM_MODEL=meta/llama-3.1-70b-instruct

# TRUSTEN_LLM_PROVIDER=gemini
# TRUSTEN_GEMINI_API_KEY=REPLACE_ME
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# GEMINI_MODEL=gemini-2.0-flash

# TRUSTEN_LLM_PROVIDER=deepseek
# DEEPSEEK_API_KEY=REPLACE_ME
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# DEEPSEEK_MODEL=deepseek-chat

# TRUSTEN_LLM_PROVIDER=openrouter
# OPENROUTER_API_KEY=REPLACE_ME
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_MODEL=deepseek/deepseek-chat

# Ollama must be reachable from inside the container; localhost would point at
# this API container, not another service or the TrueNAS host.
# TRUSTEN_LLM_PROVIDER=ollama
# OLLAMA_BASE_URL=http://REPLACE_OLLAMA_HOST:11434/v1
# OLLAMA_MODEL=llama3.1

# Optional telemetry
# POSTHOG_API_KEY=
# SENTRY_DSN=
