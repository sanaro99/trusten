{
  "manifest_version": 3,
  "name": "Trusten — Dark Pattern Scanner",
  "version": "1.0.0",
  "description": "Instantly scan any page for dark patterns. Powered by the Trusten dark-pattern detection engine.",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["http://localhost:9200/*"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Scan for Dark Patterns",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
