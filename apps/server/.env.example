# Server
NODE_ENV=development
LOG_LEVEL=info
TRUSTEN_PORT=9200

# Turnstile bot protection. Mode is intentionally explicit.
# Use `test` for local development with the deterministic verifier, `off` only
# when deliberately disabling protection, and `enforce` in the public demo.
TRUSTEN_TURNSTILE_MODE=test
# Production requires a stable random secret of at least 32 bytes. It hashes
# anonymous job capabilities and must not be exposed to the browser.
# TRUSTEN_CAPABILITY_HASH_KEY=generate-a-long-random-production-secret
# Emergency only: permits Turnstile off/test in production when explicitly 1.
# TRUSTEN_ALLOW_INSECURE_BOT_BYPASS=0
# TRUSTEN_TURNSTILE_SECRET_KEY=keep-this-server-side
# TRUSTEN_TURNSTILE_EXPECTED_HOSTNAME=demo.example.com
# TRUSTEN_TURNSTILE_EXPECTED_ACTION=scan-submit
# TRUSTEN_TURNSTILE_TIMEOUT_MS=5000
# TRUSTEN_DEMO_SESSION_LIMIT=3
# TRUSTEN_DEMO_SESSION_WINDOW_MS=3600000
# TRUSTEN_DEMO_IP_LIMIT=10
# TRUSTEN_DEMO_IP_WINDOW_MS=3600000
# TRUSTEN_DEMO_DOMAIN_LIMIT=1
# TRUSTEN_DEMO_DOMAIN_WINDOW_MS=600000
# TRUSTEN_DEMO_MAX_OUTSTANDING=2

# ─── LLM Provider ──────────────────────────────────────────────────────────────
# Set TRUSTEN_LLM_PROVIDER to pin a provider, or leave unset for auto-detection.
# Auto-detect order: cloudflare → groq → gemini → nvidia-nim → deepseek → openrouter → ollama
#
# TRUSTEN_LLM_PROVIDER=gemini   # cloudflare | groq | gemini | nvidia-nim | deepseek | openrouter | ollama
# TRUSTEN_LLM_TIMEOUT_MS=8000

# Cloudflare Workers AI (token needs Workers AI permission for this account)
# CLOUDFLARE_API_TOKEN=your-workers-ai-token
# CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
# CLOUDFLARE_MODEL=@cf/meta/llama-4-scout-17b-16e-instruct
# CLOUDFLARE_BASE_URL=https://api.cloudflare.com/client/v4/accounts/YOUR_ACCOUNT_ID/ai/v1

# Groq (choose a vision model for screenshot checks)
# GROQ_API_KEY=your-groq-key
# GROQ_BASE_URL=https://api.groq.com/openai/v1
# GROQ_MODEL=qwen/qwen3.8-27b

# Nvidia NIM
# NVIDIA_NIM_API_KEY=nvapi-...
# NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
# NVIDIA_NIM_MODEL=meta/llama-3.1-70b-instruct

# Google Gemini
# TRUSTEN_GEMINI_API_KEY=AIza...
# GEMINI_API_KEY and GOOGLE_API_KEY are also accepted (as in Applination).
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# GEMINI_MODEL=gemini-2.5-flash
# TRUSTEN_LLM_TIMEOUT_MS=30000  # Allow for Gemini screenshot latency.

# DeepSeek
# DEEPSEEK_API_KEY=sk-...
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# DEEPSEEK_MODEL=deepseek-flash

# OpenRouter (routes to any model; default: deepseek/deepseek-chat)
# OPENROUTER_API_KEY=sk-or-...
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_MODEL=deepseek/deepseek-chat

# Ollama (local, no key needed — final fallback)
# OLLAMA_BASE_URL=http://localhost:11434/v1
# OLLAMA_MODEL=llama3.1

# ─── Telemetry (optional) ──────────────────────────────────────────────────────
# POSTHOG_API_KEY=
# SENTRY_DSN=
